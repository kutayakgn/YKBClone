@{
    var layoutData = ViewData["LayoutData"] as YkbClone.LayoutData;
    layoutData ??= YkbClone.LayoutData.Create(YkbClone.MockLayoutContent.Create());
    var isHomePage = ViewData["IsHomePage"] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>@ViewData["Title"] | Yapı Kredi Header Demo</title>
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isHomePage ? "home-page" : "inner-page")">
    @await Html.PartialAsync("Header", layoutData, ViewData)

    <main class="site-main" role="main">
        @RenderBody()
    </main>

    <script src="~/js/header.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
