@using System.Globalization
@model YkbYapikredi.Application.CustomTableFeeds.BulletinsContent

<form class="ct-feed__filters ct-feed__filters--dates" data-ct-filters novalidate>
    <div class="ct-date" data-ct-date>
        <label class="ct-date__label">Başlangıç Tarihi</label>
        <span class="ct-date__control">
            <input type="text" class="ct-feed__input" placeholder="gg.aa.yyyy" maxlength="10" inputmode="numeric" autocomplete="off" data-date-input data-start-date />
            <button type="button" class="ct-date__open" aria-label="Başlangıç tarihi takvimini aç" aria-expanded="false" data-date-open>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 2v4m10-4v4M3 9h18M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="2"/></svg>
            </button>
        </span>
    </div>
    <div class="ct-date" data-ct-date>
        <label class="ct-date__label">Bitiş Tarihi</label>
        <span class="ct-date__control">
            <input type="text" class="ct-feed__input" placeholder="gg.aa.yyyy" maxlength="10" inputmode="numeric" autocomplete="off" data-date-input data-end-date />
            <button type="button" class="ct-date__open" aria-label="Bitiş tarihi takvimini aç" aria-expanded="false" data-date-open>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 2v4m10-4v4M3 9h18M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="2"/></svg>
            </button>
        </span>
    </div>
    <button type="submit" class="ct-feed__submit">Getir</button>
    <p class="ct-feed__error" data-filter-error role="alert" hidden></p>
</form>
<div class="ct-feed__table-wrap">
    <table class="ct-bulletins">
        <thead><tr><th scope="col">Tarih</th><th scope="col">Bülten Tipi</th><th scope="col">Doküman</th></tr></thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr data-ct-row data-date="@row.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                <td>@row.Date.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture)</td>
                <td>@row.BulletinType</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(row.Pdf))
                    {
                        <span>Bülteni okumak için </span><a href="@Url.Content(row.Pdf)" target="_blank" rel="noopener noreferrer">tıklayınız</a><span>.</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
