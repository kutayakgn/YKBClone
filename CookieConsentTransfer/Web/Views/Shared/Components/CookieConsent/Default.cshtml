@using YkbYapikredi.Web.Controllers
@model YkbYapikredi.Web.ViewComponents.CookieConsentViewModel

<div id="cookieConsent" data-has-choice="@(Model.HasChoice ? "true" : "false")"
     data-save-error="@Model.SaveError" data-policy-changed="@Model.PolicyChanged">
    <form id="cookieConsentToken" action="@Url.RouteUrl(CookieConsentController.SaveRouteName)"
          method="post" asp-antiforgery="false" hidden>
        @Html.AntiForgeryToken()
        <input type="hidden" name="PolicyVersion" value="@Model.PolicyVersion" />
    </form>

    <div id="cookieModal" class="cookie-modal" role="dialog" aria-modal="true"
         aria-labelledby="cookieModalTitle" tabindex="-1" hidden>
        <div class="cookie-modal-content">
            <h3 id="cookieModalTitle">@Model.Dialog.Title</h3>
            <div class="cookie-copy">@Html.Raw(Model.Dialog.Html)</div>

            @for (var index = 0; index < Model.Categories.Count; index++)
            {
                var category = Model.Categories[index];
                <div class="cookie-option @(index == Model.Categories.Count - 1 ? "last-child" : "")">
                    <div class="option-text-wrap">
                        <strong id="@(category.Id)-title">@category.Text.Title</strong>
                        <div class="cookie-copy">@Html.Raw(category.Text.Html)</div>
                    </div>
                    <div class="onoffswitch">
                        <input type="checkbox" class="onoffswitch-checkbox" id="@category.Id"
                               aria-labelledby="@(category.Id)-title" data-cookie-field="@category.Field"
                               checked="@category.Checked" disabled="@(category.Field == null)" />
                        <label class="onoffswitch-label" for="@category.Id">
                            <span class="onoffswitch-inner" aria-hidden="true"></span>
                            <span class="onoffswitch-switch" aria-hidden="true"></span>
                        </label>
                    </div>
                </div>
            }

            <div class="cookie-buttons">
                <button type="button" class="bordered" data-cookie-action="reject">@Model.Reject</button>
                <button type="button" class="filled" data-cookie-action="accept">@Model.Accept</button>
                <button type="button" class="filled" data-cookie-action="custom">@Model.Save</button>
            </div>
            <p class="cookie-save-error" role="alert" hidden></p>
        </div>
    </div>

    <div id="cookieBanner" class="cookie-banner">
        <div class="container">
            <div class="cookie-banner-content">
                <div class="text-content cookie-copy">@Html.Raw(Model.Banner.Html)</div>
                <div class="cookie-btns">
                    <button type="button" class="cookie-btn-bordered" data-cookie-action="reject">@Model.Reject</button>
                    <button type="button" class="cookie-btn" data-cookie-action="edit"
                            aria-haspopup="dialog" aria-controls="cookieModal">@Model.Edit</button>
                    <button type="button" class="cookie-btn" data-cookie-action="accept">@Model.Accept</button>
                </div>
            </div>
            <p class="cookie-save-error" role="alert" hidden></p>
        </div>
    </div>

    <button type="button" id="cookieIcon" class="cookie-icon" data-cookie-action="edit"
            aria-label="@Model.Settings" aria-haspopup="dialog" aria-controls="cookieModal" hidden>
        <img src="@Url.Content("~/assets/icons/cookie-icon.svg")" alt="" />
    </button>
</div>
