@using System.Globalization
@using YkbYapikredi.Application.CookieConsent
@using YkbYapikredi.Infrastructure.CookieConsent
@inject CookieConsentSettings CookieConsent
@inject CookieConsentCopyProvider CookieCopy

@{
    var cookieCulture = ViewData["Culture"]?.ToString() ?? CultureInfo.CurrentUICulture.Name;
    if (string.IsNullOrWhiteSpace(cookieCulture)) cookieCulture = "tr-TR";

    Context.Response.Headers["Cache-Control"] = "private, no-store";
    var settings = CookieConsent.Options;
    var policyVersion = settings.PolicyVersion;
    var measurementId = settings.MeasurementId;
    CookieConsentCopy? cookieCopy = null;
    CookiePreferences? cookiePreferences = null;

    if (policyVersion > 0)
    {
        cookieCopy = CookieCopy.Read(cookieCulture);
        cookiePreferences = CookieConsent.Read(Context);
    }

    var loadGoogleAnalytics = cookieCopy != null && cookiePreferences?.Analytics == true &&
        !string.IsNullOrEmpty(measurementId);
    if (!loadGoogleAnalytics)
    {
        CookieConsent.ClearAnalyticsCookies(Context);
    }
}

@* <head> içinde, ana tema stillerinden sonra *@
@if (cookieCopy != null)
{
    <link rel="stylesheet" href="~/css/components/cookie-consent.css" asp-append-version="true" />
}
@if (loadGoogleAnalytics)
{
    <script id="ykbCookieAnalytics" src="~/js/components/cookie-analytics.js"
            data-measurement-id="@measurementId" data-cookie-prefix="@CookieConsentSettings.AnalyticsCookiePrefix"
            asp-append-version="true" defer></script>
}

@* </body> öncesinde, diğer formların dışında *@
@if (cookieCopy != null)
{
    @await Component.InvokeAsync("CookieConsent", new { copy = cookieCopy, policyVersion, saved = cookiePreferences })
    <script src="~/js/components/cookie-consent.js" asp-append-version="true" defer></script>
}
