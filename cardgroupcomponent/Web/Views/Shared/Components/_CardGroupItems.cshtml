@using System
@model YkbYapikredi.Application.Components.CardGroupComponentModel

@{
    var pages = Model.TotalPages;
    var current = Model.CurrentPage;
}
<div data-card-group-result data-page="@current" data-total-pages="@pages" data-total-cards="@Model.TotalCards">
    <section class="row">
        @foreach (var component in Model.VisibleCards)
        {
            @await Html.PartialAsync(component.ViewName, component)
        }
    </section>
    @if (Model.TotalCards == 0)
    {
        <p>Kart bulunamadı.</p>
    }
    @if (Model.PageSize > 0 && pages > 1)
    {
        <nav class="card-group-component__pagination" aria-label="Kart sayfaları">
            <button type="button" class="card-group-component__page" data-card-group-page="1" aria-label="İlk sayfa" disabled="@(current == 1)">&lt;&lt;</button>
            <button type="button" class="card-group-component__page" data-card-group-page="@(Math.Max(1, current - 1))" aria-label="Önceki sayfa" disabled="@(current == 1)">&lt;</button>
            @for (var number = Math.Max(1, current - 2); number <= Math.Min(pages, current + 2); number++)
            {
                <button type="button" class="card-group-component__page @(number == current ? "is-active" : "")"
                        data-card-group-page="@number" aria-label="@(number + ". sayfa")"
                        aria-current="@(number == current ? "page" : null)">@number</button>
            }
            <button type="button" class="card-group-component__page" data-card-group-page="@(Math.Min(pages, current + 1))" aria-label="Sonraki sayfa" disabled="@(current == pages)">&gt;</button>
            <button type="button" class="card-group-component__page" data-card-group-page="@pages" aria-label="Son sayfa" disabled="@(current == pages)">&gt;&gt;</button>
        </nav>
    }
</div>
